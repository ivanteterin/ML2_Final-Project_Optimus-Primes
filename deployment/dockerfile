# Use an official Python runtime as a parent image
FROM python:3.9-slim-bullseye

# Set the working directory in the container
WORKDIR /app

# Install system dependencies for OpenCV and git
RUN apt-get update && apt-get install -y \
    ffmpeg libsm6 libxext6 git wget \
    --no-install-recommends && rm -rf /var/lib/apt/lists/*

# Copy the current directory contents into the container at /app
COPY . /app

# Download the YOLO pose model explicitly
RUN wget https://github.com/ultralytics/assets/releases/download/v8.4.0/yolo11n-pose.pt -O /app/yolo11n-pose.pt

# Install any needed packages specified in requirements.txt
# Since we don't have a requirements.txt, listing them explicitly
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    python-multipart \
    torch==2.0.1+cpu \
    torchvision==0.15.2+cpu \
    torchaudio==2.0.2+cpu \
    --extra-index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
    ultralytics==8.4.0 \
    opencv-python \
    "numpy<2" \
    pandas \
    scikit-learn

# Make port 8000 available to the world outside this container
EXPOSE 8000

# Run the FastAPI application when the container launches
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]